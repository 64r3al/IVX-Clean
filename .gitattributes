# Normalize line endings. Text files are stored as LF in the repo and checked out
# as CRLF on Windows. Binary assets are left untouched.
* text=auto

*.cs       text eol=crlf diff=csharp
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.sln      text eol=crlf
*.slnx     text eol=crlf
*.xaml     text eol=crlf
*.manifest text eol=crlf
*.json     text eol=lf
*.yml      text eol=lf
*.md       text eol=lf
*.editorconfig text eol=lf

*.png  binary
*.ico  binary
*.zip  binary
