<Project>

  <!-- Solution-wide build settings for IVX Clean. Made by IVX. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Deterministic, reproducible builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Lock files make CI restores reproducible (locked-mode restore). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Branding / versioning. The release workflow overrides Version from the tag. -->
    <Product>IVX Clean</Product>
    <Company>IVX</Company>
    <Authors>IVX</Authors>
    <Copyright>Copyright (c) 2026 IVX</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Central package management is on via Directory.Packages.props. -->

</Project>
