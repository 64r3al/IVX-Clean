{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/64r3al/IVX-Clean/rules/schema.json",
  "title": "IVX Clean rule catalog file",
  "description": "A catalog file is { \"rules\": [ Rule, ... ] }. Enforced in code by IvxClean.Core.Rules.RuleValidator and the Rules.Tests suite.",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "name", "category", "level", "risk", "action", "why", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 1, "maximum": 4 },
        "risk": { "enum": ["safe", "caution", "expert"] },
        "action": { "enum": ["delete", "quarantine", "command"] },
        "command": { "type": "string" },
        "detect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anyExists": { "type": "array", "items": { "type": "string" } },
            "anyProcessKnown": { "type": "array", "items": { "type": "string" } }
          }
        },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
        "requiresClosed": { "type": "array", "items": { "type": "string" } },
        "services": { "type": "array", "items": { "type": "string" } },
        "why": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "target": {
      "type": "object",
      "required": ["base"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string", "pattern": "^\\{[A-Za-z]+\\}" },
        "profileDirs": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "requireFile": { "type": "string" } }
        },
        "subPaths": { "type": "array", "items": { "type": "string" } },
        "fileGlobs": { "type": "array", "items": { "type": "string" } },
        "minAgeHours": { "type": "integer", "minimum": 0 },
        "deleteBaseIfEmpty": { "type": "boolean" }
      }
    }
  }
}
