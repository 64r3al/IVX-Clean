<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>IvxClean.App</RootNamespace>
    <AssemblyName>IVXClean</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ivxclean.ico</ApplicationIcon>
    <!-- Icon is added in the UI phase; keep the build tolerant until then. -->
    <ApplicationIcon Condition="!Exists('Assets\ivxclean.ico')"></ApplicationIcon>
    <!-- UI-layer analyzer frictions: bindable/command members need not be static (CA1822), and
         display formatting intentionally uses the current UI culture (CA1305). -->
    <NoWarn>$(NoWarn);CA1822;CA1305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IvxClean.Core\IvxClean.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
