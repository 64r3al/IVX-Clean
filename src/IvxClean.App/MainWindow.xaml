<ui:FluentWindow x:Class="IvxClean.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="IVX Clean"
                 Width="1280" Height="820" MinWidth="1024" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource Brush.Bg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.TitleBar}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,12,16,16">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,24">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="✦" FontSize="20" Foreground="{DynamicResource Brush.AccentInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="IVX Clean" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="Safe PC cleaner" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Footer (pinned bottom) -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,8,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Center">
                        <Run Text="Made by " /><Run Text="IVX" FontWeight="Bold" /><Run Text=" · v" /><Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- Nav groups -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="CLEANING" Style="{StaticResource Text.NavGroup}" Margin="8,4,0,6" />
                    <Button Content="Dashboard" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding GoDashboardCommand}" Margin="0,2" />
                    <Button Content="Quarantine" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding GoQuarantineCommand}" Margin="0,2" />
                    <TextBlock Text="TOOLS" Style="{StaticResource Text.NavGroup}" Margin="8,16,0,6" />
                    <Button Content="Unwanted software" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding GoSoftwareCommand}" Margin="0,2" />
                    <TextBlock Text="ABOUT" Style="{StaticResource Text.NavGroup}" Margin="8,16,0,6" />
                    <Button Content="Settings" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding GoSettingsCommand}" Margin="0,2" />
                    <Button Content="About" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding GoAboutCommand}" Margin="0,2" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TitleBar Grid.Row="0" Title="" ShowMaximize="True" ShowMinimize="True" />
            <ContentControl Grid.Row="1" Content="{Binding Navigation.Current}" Margin="0" />
        </Grid>
    </Grid>
</ui:FluentWindow>
