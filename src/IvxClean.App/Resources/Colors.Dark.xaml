<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- IVX Clean dark theme tokens (§7.2). Made by IVX. -->
    <Color x:Key="Color.Bg">#0D1114</Color>
    <Color x:Key="Color.TitleBar">#101518</Color>
    <Color x:Key="Color.Surface">#151B1F</Color>
    <Color x:Key="Color.SurfaceRaised">#1B2227</Color>
    <Color x:Key="Color.Border">#232C33</Color>
    <Color x:Key="Color.BorderStrong">#2E3941</Color>
    <Color x:Key="Color.Divider">#1E262C</Color>
    <Color x:Key="Color.Text">#ECF2F3</Color>
    <Color x:Key="Color.TextMuted">#A6B3B8</Color>
    <Color x:Key="Color.TextSubtle">#7C8A90</Color>
    <Color x:Key="Color.Accent">#4FE3C1</Color>
    <Color x:Key="Color.AccentHover">#74EACF</Color>
    <Color x:Key="Color.AccentInk">#03251D</Color>
    <Color x:Key="Color.SafeText">#74EACF</Color>
    <Color x:Key="Color.Caution">#F2B544</Color>
    <Color x:Key="Color.CautionText">#F2C26B</Color>
    <Color x:Key="Color.Expert">#FF8A7A</Color>
    <Color x:Key="Color.ExpertText">#FFB3A8</Color>
    <Color x:Key="Color.Danger">#C42B1C</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="{StaticResource Color.TitleBar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextSubtle" Color="{StaticResource Color.TextSubtle}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentInk" Color="{StaticResource Color.AccentInk}" />
    <SolidColorBrush x:Key="Brush.SafeText" Color="{StaticResource Color.SafeText}" />
    <SolidColorBrush x:Key="Brush.SafeBg" Color="#4FE3C1" Opacity="0.12" />
    <SolidColorBrush x:Key="Brush.Caution" Color="{StaticResource Color.Caution}" />
    <SolidColorBrush x:Key="Brush.CautionText" Color="{StaticResource Color.CautionText}" />
    <SolidColorBrush x:Key="Brush.CautionBg" Color="#F2B544" Opacity="0.14" />
    <SolidColorBrush x:Key="Brush.Expert" Color="{StaticResource Color.Expert}" />
    <SolidColorBrush x:Key="Brush.ExpertText" Color="{StaticResource Color.ExpertText}" />
    <SolidColorBrush x:Key="Brush.ExpertBg" Color="#FF8A7A" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />

</ResourceDictionary>
