<UserControl x:Class="IvxClean.App.Views.CleaningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="40,32,40,40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
            <ui:ProgressRing IsIndeterminate="True" Width="120" Height="120" HorizontalAlignment="Center" />
            <TextBlock Text="Cleaning…" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,20,0,8" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="8" Width="420" />
            <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Run Text="{Binding ItemsProcessed, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding ItemsTotal, Mode=OneWay}" /><Run Text=" items" />
            </TextBlock>
            <TextBlock Text="{Binding CurrentCategory}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Text.Path}" HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="560" />
        </StackPanel>
    </Grid>
</UserControl>
