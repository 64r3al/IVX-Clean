<UserControl x:Class="IvxClean.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,24,40,40">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource Text.Title}" Margin="0,2,0,20" />

            <Border Style="{StaticResource Card}" Padding="28">
                <StackPanel>
                    <TextBlock Text="Space you can likely free" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="Run your first scan" Style="{StaticResource Text.Display}" Margin="0,8,0,4" />
                    <TextBlock Style="{StaticResource Text.Caption}" MaxWidth="620" HorizontalAlignment="Left"
                               Text="A new scan shows exact numbers, and nothing is deleted until you review it." />

                    <TextBlock Text="Choose a level" Style="{StaticResource Text.Section}" Margin="0,24,0,8" />
                    <ListBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="230" Margin="0,0,12,12" Padding="16" CornerRadius="10"
                                        Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subtitle}" />
                                            <Border Background="{DynamicResource Brush.SafeBg}" CornerRadius="6" Padding="6,1" Margin="8,2,0,0"
                                                    VerticalAlignment="Center" Visibility="{Binding Recommended, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Recommended" FontSize="11" Foreground="{DynamicResource Brush.SafeText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="Scan now" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Command="{Binding ScanNowCommand}"
                            AutomationProperties.Name="Scan now" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Always protected" Style="{StaticResource Text.Section}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,8" CornerRadius="8"><TextBlock Text="Documents &amp; Desktop" Style="{StaticResource Text.Caption}" /></Border>
                        <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,8" CornerRadius="8"><TextBlock Text="Downloads" Style="{StaticResource Text.Caption}" /></Border>
                        <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,8" CornerRadius="8"><TextBlock Text="Photos &amp; videos" Style="{StaticResource Text.Caption}" /></Border>
                        <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,8" CornerRadius="8"><TextBlock Text="Games, saves &amp; mods" Style="{StaticResource Text.Caption}" /></Border>
                        <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,8" CornerRadius="8"><TextBlock Text="Drivers &amp; Windows" Style="{StaticResource Text.Caption}" /></Border>
                        <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,8" CornerRadius="8"><TextBlock Text="Passwords &amp; history" Style="{StaticResource Text.Caption}" /></Border>
                        <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,8" CornerRadius="8"><TextBlock Text="Autosave &amp; recovery" Style="{StaticResource Text.Caption}" /></Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
