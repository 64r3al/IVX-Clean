<UserControl x:Class="IvxClean.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32,40,40">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="28">
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brush.SafeBg}" HorizontalAlignment="Left">
                        <TextBlock Text="✓" FontSize="28" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Clean finished" Style="{StaticResource Text.Title}" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Text.ReportFigure}" Margin="0,8,0,0">
                        <Run Text="{Binding FreedText, Mode=OneWay}"/><Run Text=" freed"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                        <Run Text="Done in "/><Run Text="{Binding TimeText, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="View log" Style="{StaticResource QuietButton}" Command="{Binding ViewLogCommand}" Margin="0,0,8,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="What we did" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0">
                        <Run Text="Deleted: "/><Run Text="{Binding DeletedCount, Mode=OneWay}"/>
                        <Run Text="   Quarantined: "/><Run Text="{Binding QuarantinedCount, Mode=OneWay}"/>
                        <Run Text="   Skipped: "/><Run Text="{Binding SkippedCount, Mode=OneWay}"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Categories}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Body}" />
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
