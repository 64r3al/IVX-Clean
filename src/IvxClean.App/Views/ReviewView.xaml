<UserControl x:Class="IvxClean.App.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,24,40,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Left: grouped, virtualized item list -->
        <DockPanel Grid.Column="0" Margin="0,0,24,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Review before cleaning" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,12">
                    <Run Text="Found "/><Run Text="{Binding FoundCount, Mode=OneWay}"/><Run Text=" items · Untick anything you want to keep."/>
                </TextBlock>
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,12" />
            </StackPanel>

            <ListView ItemsSource="{Binding ItemsView}"
                      Background="Transparent" BorderThickness="0"
                      SelectionMode="Single"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.ScrollUnit="Pixel">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{Binding IsIncludable}" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding FullPath}" Style="{StaticResource Text.Path}" ToolTip="{Binding FullPath}" />
                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextSubtle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="8" Padding="10,8" Margin="0,8,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox VerticalAlignment="Center"
                                                  Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding Name}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Run Text="("/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>
        </DockPanel>

        <!-- Right: sticky summary -->
        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Selected to clean" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding CleanButtonText}" Style="{StaticResource Text.ReportFigure}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,12">
                    <Run Text="of "/><Run Text="{Binding FoundCount, Mode=OneWay}"/><Run Text=" found"/>
                </TextBlock>
                <TextBlock Text="{Binding SplitText}" Style="{StaticResource Text.Caption}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,12">
                    <Run Text="{Binding SkippedOrProtectedCount, Mode=OneWay}"/><Run Text=" skipped or protected"/>
                </TextBlock>
                <CheckBox Content="Create a restore point first" IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}" Margin="0,0,0,4" />
                <TextBlock Text="Lets Windows roll back if anything feels off." Style="{StaticResource Text.Caption}" Margin="0,0,0,16" />
                <Button Content="{Binding CleanButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}"
                        IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Clean selected items" />
                <Button Content="Export list as text" Style="{StaticResource QuietButton}" Command="{Binding ExportListCommand}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
