<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>IvxClean.Core</RootNamespace>
    <AssemblyName>IvxClean.Core</AssemblyName>
    <!-- Core has NO WPF dependency. UseWPF stays off. -->
    <!-- LibraryImport source generation emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The rule catalog and protected lists are embedded into Core at build. -->
    <EmbeddedResource Include="..\..\rules\protected.json">
      <LogicalName>IvxClean.Core.Rules.protected.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IvxClean.Core.Tests" />
    <InternalsVisibleTo Include="IvxClean.Rules.Tests" />
  </ItemGroup>

</Project>
