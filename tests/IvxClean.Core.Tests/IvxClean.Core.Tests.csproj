<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test assemblies may trip some analyzers; keep warnings-as-errors but relax doc comments. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Underscored test method names are the intended xUnit convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IvxClean.Core\IvxClean.Core.csproj" />
    <ProjectReference Include="..\IvxClean.TestSupport\IvxClean.TestSupport.csproj" />
  </ItemGroup>

</Project>
