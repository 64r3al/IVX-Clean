<Configuration>
  <!--
    Windows Sandbox config for safely testing IVX Clean release builds.
    1. Publish:  dotnet publish src/IvxClean.App/IvxClean.App.csproj -c Release -r win-x64 --self-contained -o publish
    2. Edit the HostFolder below to the ABSOLUTE path of that publish folder.
    3. Double-click this file (Windows Sandbox must be enabled in Windows Features).
    The folder is mapped READ-ONLY, so a test run can never modify the host.
  -->
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\path\to\IVX-Clean\publish</HostFolder>
      <SandboxFolder>C:\IVXClean</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>explorer.exe C:\IVXClean</Command>
  </LogonCommand>
  <MemoryInMB>4096</MemoryInMB>
</Configuration>
